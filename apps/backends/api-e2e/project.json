{
  "name": "@autodev/api-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["@autodev/api"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "dependsOn": ["@autodev/api:build", "@autodev/api:serve"],
      "options": {
        "jestConfig": "apps/backends/api-e2e/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
